{
  "name": "transportal",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "ocr:prepare": "node scripts/ocr/prepare.mjs",
    "build:desktop": "pnpm ocr:prepare && pnpm build",
    "build:release": "node scripts/build-release.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "test:integrity": "node --test scripts/integrity/checks.node.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "version:set": "node scripts/sync-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "i18next": "^27.2.9",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.7",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
