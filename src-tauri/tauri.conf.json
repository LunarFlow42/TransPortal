{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TransPortal",
  "version": "0.1.0",
  "identifier": "com.transportal.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "shell",
        "title": "TransPortal",
        "url": "index.html#/shell",
        "width": 460,
        "height": 240,
        "minWidth": 320,
        "minHeight": 120,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "center": true,
        "visible": true,
        "skipTaskbar": true,
        "focus": true,
        "noRedirectionBitmap": true
      },
      {
        "label": "ocr-region",
        "title": "TransPortal Region",
        "url": "index.html#/ocr-region",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "noRedirectionBitmap": true
      },
      {
        "label": "settings",
        "title": "TransPortal Settings",
        "url": "index.html#/settings",
        "width": 680,
        "height": 580,
        "minWidth": 620,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: https:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "resources/ocr-bundle/": "ocr/" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
